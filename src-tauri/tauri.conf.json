{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "votekickViewer3D",
  "mainBinaryName": "votekickViewer3D",
  "version": "0.0.2",
  "identifier": "com.votekick.viewer3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "appDirectoriesOverride": {
      "localData": "$DATA/votekickViewer3D/cache/webview"
    },
    "windows": [
      {
        "title": "!votekickViewer3D",
        "width": 640,
        "height": 480,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "!votekickAlex",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["glb"], "name": "glTF Binary Model", "mimeType": "model/gltf-binary", "role": "Viewer" },
      { "ext": ["gltf"], "name": "glTF Model", "mimeType": "model/gltf+json", "role": "Viewer" },
      { "ext": ["fbx"], "name": "Autodesk FBX Model", "role": "Viewer" },
      { "ext": ["obj"], "name": "Wavefront OBJ Model", "role": "Viewer" },
      { "ext": ["stl"], "name": "Stereolithography Model", "role": "Viewer" },
      { "ext": ["ply"], "name": "Polygon File Format Model", "role": "Viewer" },
      { "ext": ["dae"], "name": "COLLADA Model", "role": "Viewer" },
      { "ext": ["3ds"], "name": "Autodesk 3ds Model", "role": "Viewer" }
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "./nsis/installer-template.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
